{
    "name": "vrcx-headless-server",
    "version": "0.1.0",
    "private": true,
    "description": "Headless VRCX server: sole owner of VRCX.sqlite3 and (from phase 2) the VRChat API connection",
    "license": "MIT",
    "bin": {
        "vrcx-server": "./src/cli.js"
    },
    "type": "module",
    "main": "src/index.js",
    "scripts": {
        "start": "node --import ./register-hooks.mjs src/cli.js serve",
        "cli": "node --import ./register-hooks.mjs src/cli.js",
        "check-deps": "node ./scripts/check-deps.js",
        "test": "vitest run"
    },
    "dependencies": {
        "@tanstack/vue-query": "^5.101.4",
        "@vue/runtime-core": "^3.5.40",
        "dayjs": "^1.11.21",
        "pinia": "^4.0.2",
        "tough-cookie": "^6.0.1",
        "vue": "^3.5.40",
        "vue-i18n": "^11.4.8",
        "vue-router": "^5.2.0",
        "ws": "^8.21.2"
    },
    "engines": {
        "node": ">=22.5.0"
    }
}

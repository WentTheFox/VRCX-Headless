<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Fork-only (CLAUDE.md §5). Tests for the pure/portable halves of the fork's native code. The sources
    are linked, not referenced, because VRCX-Electron.csproj is a Library that needs the OpenVR/Node
    interop to build. Windows-only registry tests skip themselves on other OSes.
    Run: dotnet test tests/dotnet/VRCX.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>VRCX.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Dotnet\AppApi\Electron\WindowsRegistry.cs" Link="Linked\WindowsRegistry.cs" />
    <Compile Include="..\..\..\Dotnet\AppApi\Electron\WindowsShell.cs" Link="Linked\WindowsShell.cs" />
    <Compile Include="..\..\..\Dotnet\Overlay\Electron\WindowsOverlay.cs" Link="Linked\WindowsOverlay.cs" />
    <Compile Include="..\..\..\Dotnet\Overlay\Electron\GLContextWindows.cs" Link="Linked\GLContextWindows.cs" />
    <Compile Include="..\..\..\Dotnet\Overlay\Electron\GLTextureWriter.cs" Link="Linked\GLTextureWriter.cs" />
    <Compile Include="..\..\..\Dotnet\Overlay\OpenVR\openvr_api.cs" Link="Linked\openvr_api.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.2.2" />
  </ItemGroup>
</Project>
